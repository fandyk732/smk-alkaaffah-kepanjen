rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // HELPER FUNCTIONS
    // -------------------------------------------------------------

    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.token.email)).data;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.token.email));
    }

    function hasRole(roleName) {
      return isAuthenticated() && userDocExists() && (
        (getUserData().role is list && roleName in getUserData().role) ||
        (getUserData().role is string && getUserData().role == roleName)
      );
    }

    function isSuperadmin() {
      return hasRole('superadmin');
    }

    function isPanitiaPpdb() {
      return hasRole('panitia_ppdb') || hasRole('panitia_PPDB') || hasRole('admin_ppdb');
    }

    function isAdminArtikel() {
      return isSuperadmin() || hasRole('admin_artikel');
    }

    // -------------------------------------------------------------
    // ATURAN KOLEKSI
    // -------------------------------------------------------------

    // 1. USERS
    match /users/{userEmail} {
      allow read: if isAuthenticated();
      allow write: if isSuperadmin();
    }

    // 2. SETTINGS & ANNOUNCEMENT
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperadmin() || hasRole('admin_announcement');

      match /{subCollection}/{subDocId} {
        allow read: if true;
        allow write: if isSuperadmin() || hasRole('admin_announcement');
      }
    }

    // 3. VACANCIES (LOWKER BKK)
    match /vacancies/{vacancyId} {
      allow read: if true;
      allow write: if isSuperadmin() || hasRole('admin_bkk');
    }

    // 4. APPLICATIONS (PELAMAR BKK)
    match /applications/{appId} {
      allow create: if !exists(/databases/$(database)/documents/applications/$(appId));
      allow read, update, delete: if isSuperadmin() || hasRole('admin_bkk');
    }
    match /job_applications/{appId} {
      allow create: if !exists(/databases/$(database)/documents/job_applications/$(appId));
      allow read, update, delete: if isSuperadmin() || hasRole('admin_bkk');
    }

    // 5. PPDB (Data Utama)
    match /ppdb/{docId} {
      allow create: if !exists(/databases/$(database)/documents/ppdb/$(docId));
      allow read, delete: if isSuperadmin() || isPanitiaPpdb();
      allow update: if isSuperadmin()
                    || isPanitiaPpdb()
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tes']);
    }

    // 5b. PPDB_PUBLIC (Versi Publik)
    match /ppdb_public/{docId} {
      allow read: if true;

      allow create: if !exists(/databases/$(database)/documents/ppdb_public/$(docId))
                    && existsAfter(/databases/$(database)/documents/ppdb/$(docId))
                    && request.resource.data.keys().hasOnly([
                         'namaLengkap',
                         'nisn',
                         'noRegistrasi',
                         'asalSekolah',
                         'pilihanJurusan',
                         'statusPendaftaran',
                         'gelombangId',
                         'namaGelombang'
                       ]);

      allow update, delete: if isSuperadmin() || isPanitiaPpdb();
    }

    // 🏆 RULES UNTUK GELOMBANG SPMB
    match /gelombang_spmb/{document} {
      allow read: if true;
      allow write: if isSuperadmin() || isPanitiaPpdb();
    }

    // 6. ALUMNI (Data Publik — TIDAK BOLEH ada whatsapp/email/nisn di sini)
    match /alumni/{docId} {
      allow read: if true;
      allow create: if !exists(/databases/$(database)/documents/alumni/$(docId));
      allow update, delete: if isSuperadmin() || hasRole('admin_alumni');
    }

    // 6b. TRACER_PRIVATE (whatsapp, email, nisn alumni — admin_alumni only)
    match /tracer_private/{docId} {
      allow create: if !exists(/databases/$(database)/documents/tracer_private/$(docId));
      allow read, update, delete: if isSuperadmin() || hasRole('admin_alumni');
    }

    // 7. BERITA
    match /berita/{beritaId} {
      allow read: if true;

      allow update: if isAdminArtikel()
                    || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);

      allow create, delete: if isAdminArtikel();
    }

    // 8. GALERI
    match /galeri/{docId} {
      allow read: if true;
      allow write: if isSuperadmin() || hasRole('admin_galeri');
    }

    // 9. KOMENTAR
    match /comments/{commentId} {
      allow read, create: if true;
      allow update: if false;
      allow delete: if isSuperadmin() || hasRole('admin_artikel');
    }
  }
}